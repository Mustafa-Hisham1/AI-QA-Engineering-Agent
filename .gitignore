# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*

# ---------------------------------------------------------------------------
# Build / cache output
# ---------------------------------------------------------------------------
dist/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Local runtime artifacts (evidence, reports, raw API dumps).
# These can contain credentials, PII, or internal product detail.
# ---------------------------------------------------------------------------
.artifacts/
evidence/
reports/

# Pre-regeneration snapshot written by `npm run testcases:check -- --snapshot`.
# Removed by a clean check; kept on a failed one so lost values can be restored.
test-cases.previous.md

# Playwright defaults, should anything run outside playwright.config.ts. Real
# runs write under .artifacts/ (src/automation/artifact-policy.ts). Failure
# output can describe the page under test, so it is never committed.
test-results/
playwright-report/
blob-report/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
